{
  "name": "pg-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cross-platform general PostgreSQL viewer (web UI + Express API + optional Electron desktop shell)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n SERVER,WEB \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "cross-env NODE_ENV=production npm run build && node server/index.js",
    "desktop": "npm run build && electron .",
    "desktop:dist": "npm run build && electron-builder",
    "test": "node --test tests/"
  },
  "build": {
    "appId": "com.pgviewer.app",
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "vite": "^5.4.0"
  }
}
